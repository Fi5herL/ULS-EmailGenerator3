{
  "manifest_version": 3,
  "name": "ULS Flex Email Generator",
  "version": "3.0.0",
  "description": "MV3 migration of FlexEmailGeneratorExcelBased userscript for portal.ul.com",
  "permissions": [
    "storage",
    "clipboardWrite",
    "contextMenus"
  ],
  "host_permissions": [
    "https://portal.ul.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.ul.com/Project/Details/*"
      ],
      "js": [
        "libs/js-yaml.min.js",
        "libs/xlsx.full.min.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Toggle Flex Email Generator panel"
    },
    "switch-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Switch template mode"
    },
    "reload-custom-template": {
      "description": "Reload custom Excel templates"
    }
  },
  "action": {
    "default_title": "ULS Flex Email Generator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
